{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "The JSON body of every error response Gotcha generates.\n\nIt serializes as `{\"error\": \"...\"}`, plus a `fields` map for failures that report more than\none problem: `Valid` sends `{\"error\": \"validation failed\", \"fields\": {\"name\": [\"is\nrequired\"]}}`. `fields` is omitted when there is nothing to report, so every other provider's\nbody is unchanged. The type is public so it can be declared as the body of an OpenAPI response\n(`body = \"ErrorBody\"` in `#[api(errors(...))]` / `#[api(responses(...))]`), and so applications\ncan reuse the same wire shape for their own errors.",
        "properties": {
          "error": {
            "description": "Human-readable description of the failure.",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Per-field failure messages keyed by the field's flattened path (for example `address.city`\nor `items[0].name`). Omitted when `None`.",
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Payload": {
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "API",
    "version": "0.1.0"
  },
  "openapi": "3.2.0",
  "paths": {
    "/json": {
      "post": {
        "deprecated": false,
        "operationId": "json_body",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Payload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "text response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request rejected: invalid JSON body"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request rejected: JSON body too large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request rejected: missing or invalid JSON content type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request rejected: JSON body did not match the expected type"
          }
        },
        "summary": "Json Body"
      }
    },
    "/upload": {
      "post": {
        "deprecated": false,
        "operationId": "multipart_body",
        "parameters": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {}
          },
          "description": "Multipart form data",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "text response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request rejected: invalid multipart boundary"
          }
        },
        "summary": "Multipart Body"
      }
    }
  }
}