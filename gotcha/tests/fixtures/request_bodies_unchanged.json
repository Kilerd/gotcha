              }
            },
            "description": "text response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request rejected: invalid form body"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
